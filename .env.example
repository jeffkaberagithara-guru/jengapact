# ─────────────────────────────────────────────────────────────────────────────
# JengaPact — environment contract
#
# Copy to `.env.local` for development:  cp .env.example .env.local
# Only variables actually read by the application appear here.
# NEVER commit a populated .env file. Placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 14+. Use a pooled URL in serverless environments and a direct URL
# for migrations (db:generate / db:migrate read DIRECT_DATABASE_URL first).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jengapact
DIRECT_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing/encryption secret for sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Document storage ─────────────────────────────────────────────────────────
# `local` writes to ./.data/storage (development only, refused in production).
# `s3` requires the STORAGE_* credentials below.
STORAGE_DRIVER=local
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_SIGNED_URL_TTL=300
IMAGES_CDN_HOST=

# ── Signing / e-signature provider ───────────────────────────────────────────
# `disabled` keeps execution in an unmistakable test-only state. No provider is
# configured out of the box; see docs/LEGAL-COMPLIANCE-REGISTER.md.
SIGNING_PROVIDER=disabled
SIGNING_API_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
# `mock` records notifications in the database without delivering them.
NOTIFICATIONS_DRIVER=mock
NOTIFICATIONS_FROM_EMAIL=no-reply@jengapact.example

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
