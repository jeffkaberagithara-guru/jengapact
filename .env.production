NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=production

# Local dev: the dedicated `jengapact` PostgreSQL schema lives in the local
# `sokobuild` database because the unprivileged local role cannot CREATE
# DATABASE. For production, create a database (scripts/create-database.sql) and
# point DATABASE_URL at it; the app schema stays `jengapact`.
DATABASE_URL=postgresql://sokobuild:sokobuild_local_dev@localhost:5432/sokobuild
DIRECT_DATABASE_URL=postgresql://sokobuild:sokobuild_local_dev@localhost:5432/sokobuild

AUTH_SECRET=wy4Y26NOkJoOb2Cj8CuW-XvX2aVqMX1FTdx-bDEOghk
AUTH_URL=http://localhost:3000

STORAGE_DRIVER=local
STORAGE_REGION=af-south-1
STORAGE_SIGNED_URL_TTL=300

SIGNING_PROVIDER=disabled
NOTIFICATIONS_DRIVER=mock
NOTIFICATIONS_FROM_EMAIL=no-reply@jengapact.example
LOG_LEVEL=info
